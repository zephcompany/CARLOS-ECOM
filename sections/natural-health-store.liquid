  <!-- DEPOIMENTOS DE REVENDEDORES -->
  <section class="sec tight">
    <div class="wrap">
      <div class="sec-head"><div class="t"><span class="eyebrow">Quem já vende</span><h2 class="h2">Revendedores que cresceram com a gente</h2></div></div>
      <div class="quotes">
        <div class="quote"><span class="stars"><i></i><i></i><i></i><i></i><i></i></span><p>"Coloquei a Vittari no meu mercadinho e virou o refrigerante mais pedido. Margem ótima e reposição rápida."</p><div class="who"><span class="av2" data-av="Anderson Lima" data-fem="0"></span><span><b>Anderson Lima</b><small>Mercado · Fortaleza, CE</small></span></div></div>
        <div class="quote"><span class="stars"><i></i><i></i><i></i><i></i><i></i></span><p>"O +Power Energy sai muito na minha lanchonete. O gerente de conta me ajudou a montar o mix ideal."</p><div class="who"><span class="av2" data-av="Priscila Nunes" data-fem="1"></span><span><b>Priscila Nunes</b><small>Lanchonete · Goiânia, GO</small></span></div></div>
        <div class="quote"><span class="stars"><i></i><i></i><i></i><i></i><i></i></span><p>"Comecei com o kit degustação e hoje faço pedido de atacado todo mês. Recomendo demais."</p><div class="who"><span class="av2" data-av="Marcos Teixeira" data-fem="0"></span><span><b>Marcos Teixeira</b><small>Distribuidora · Campinas, SP</small></span></div></div>
      </div>
    </div>
  </section>

  <!-- FORMULÁRIO PRINCIPAL -->
  <section class="sec" id="reseller-form">
    <div class="wrap">
      <div class="sec-head"><div class="t"><span class="eyebrow">Cadastro</span><h2 class="h2">Solicite sua conta de revenda</h2></div></div>
      <div class="form">
        <div class="field-l"><label>Nome completo</label><input placeholder="Seu nome"></div>
        <div class="field-l"><label>Nome da empresa</label><input placeholder="Razão social / fantasia"></div>
        <div class="field-l"><label>E-mail</label><input placeholder="voce@empresa.com"></div>
        <div class="field-l"><label>Telefone / WhatsApp</label><input placeholder="(00) 00000-0000"></div>
        <div class="field-l"><label>CNPJ (opcional)</label><input placeholder="00.000.000/0000-00"></div>
        <div class="field-l"><label>Cidade / UF</label><input placeholder="Cidade — UF"></div>
        <div class="field-l"><label>Tipo de negócio</label><input placeholder="Mercado, lanchonete, distribuidora..."></div>
        <div class="field-l"><label>Volume estimado / mês</label><input placeholder="Ex.: 200 unidades"></div>
