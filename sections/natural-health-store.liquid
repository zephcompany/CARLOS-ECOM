      <div class="steps">
        <div class="step"><span class="num">1</span><h3 class="h3">Preencha o cadastro</h3><p class="muted" style="font-size:14px">Conte um pouco sobre o seu negócio.</p></div>
        <div class="step"><span class="num">2</span><h3 class="h3">Aprovação em 48h</h3><p class="muted" style="font-size:14px">Nosso time analisa e libera seu acesso.</p></div>
        <div class="step"><span class="num">3</span><h3 class="h3">Comece a vender</h3><p class="muted" style="font-size:14px">Faça seu primeiro pedido no atacado.</p></div>
