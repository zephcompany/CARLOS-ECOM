<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#03591A">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <title>{% if page_title %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  {{ 'natural-health.css' | asset_url | stylesheet_tag }}
  <style>
    /* Evita piscar o contador antigo antes da leitura do carrinho real. */
    #cart-count{display:none}
  </style>
</head>
<body>
  {{ content_for_layout }}
  <script src="{{ 'natural-health.js' | asset_url }}" defer></script>
  <script src="{{ 'nh-hotfix.js' | asset_url }}" defer></script>
</body>
</html>
