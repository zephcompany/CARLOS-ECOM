<section class="shopify-system-page"><a href="{{ routes.root_url }}" style="display:inline-block;margin-bottom:18px">← Início</a><h1>Busca</h1><form action="{{ routes.search_url }}" method="get" style="display:flex;gap:10px;margin-bottom:30px"><input name="q" value="{{ search.terms | escape }}" style="flex:1;height:46px;border:1px solid #111;padding:0 14px"><button class="btn" type="submit">Buscar</button></form>{% if search.performed %}<div class="shopify-product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}<article class="shopify-product-card"><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% endif %}<h3>{{ item.title }}</h3><div style="font-weight:800;font-size:20px">{{ item.price | money }}</div></a></article>{% endif %}{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Busca","settings":[]}{% endschema %}