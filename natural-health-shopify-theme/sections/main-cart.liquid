<section class="shopify-system-page">
  <a href="{{ routes.root_url }}" style="display:inline-block;margin-bottom:18px">← Continuar comprando</a>
  <h1>Seu carrinho</h1>
  {% if cart.item_count == 0 %}<p>Seu carrinho está vazio.</p>{% else %}
  <form action="{{ routes.cart_url }}" method="post">
    {% for item in cart.items %}
      <div class="shopify-cart-row">
        <a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a>
        <div><a href="{{ item.url }}"><b>{{ item.product.title }}</b></a><div>{{ item.final_price | money }}</div><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:80px;height:38px;border:1px solid #111;padding:0 10px;margin-top:8px"></div>
        <b>{{ item.final_line_price | money }}</b>
      </div>
    {% endfor %}
    <div style="display:flex;justify-content:flex-end;margin-top:24px"><div style="width:min(100%,380px)"><div style="display:flex;justify-content:space-between;font-size:22px;font-weight:800;margin-bottom:16px"><span>Total</span><span>{{ cart.total_price | money }}</span></div><button class="btn ghost block" type="submit" name="update">Atualizar carrinho</button><button class="btn block" type="submit" name="checkout" style="margin-top:10px">Finalizar compra</button></div></div>
  </form>{% endif %}
</section>
{% schema %}{"name":"Carrinho","settings":[]}{% endschema %}